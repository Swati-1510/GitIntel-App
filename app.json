{
  "expo": {
    "name": "GitIntel-App",
    "slug": "GitIntel-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/Icons/icon.svg",
    "scheme": "gitintelapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/Icons/icon.svg",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/Icons/icon.svg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./src/assets/Icons/icon.svg",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
